# ---------------------------------------------------------------------------
# TheVisualParadox — environment configuration
# Copy to `.env.local` and fill in. All values here are safe placeholders;
# nothing real is committed. These feed lib/config.ts (siteConfig).
# ---------------------------------------------------------------------------

# Public site URL (used for metadata / canonical / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Content source: "demo" uses lib/data (local demo dataset),
# "sanity" (Phase 5) will read from the CMS.
NEXT_PUBLIC_CONTENT_SOURCE=demo

# Contact / booking placeholders — replace with real details later.
NEXT_PUBLIC_CONTACT_EMAIL=hello@thevisualparadox.example
NEXT_PUBLIC_CONTACT_PHONE=+91 00000 00000
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000
NEXT_PUBLIC_INSTAGRAM_HANDLE=YOUR_INSTAGRAM_HANDLE
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/YOUR_INSTAGRAM_HANDLE

# Sanity (Phase 5 — not used yet)
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
